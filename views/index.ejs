    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-bottom: 30px;">
        <div style="text-align: center; padding: 30px; background: linear-gradient(135deg, #3B82F6, #1D4ED8); border-radius: 15px; color: white;">
            <div style="font-size: 3rem; margin-bottom: 15px;">👤</div>
            <h3 style="margin-bottom: 15px;">Register New User</h3>
            <p style="margin-bottom: 20px; opacity: 0.9;">Capture facial data for 5 seconds to train the recognition system</p>
            <a href="/register" class="btn" style="background: white; color: #3B82F6;">Start Registration</a>
        </div>
        
        <div style="text-align: center; padding: 30px; background: linear-gradient(135deg, #10B981, #047857); border-radius: 15px; color: white;">
            <div style="font-size: 3rem; margin-bottom: 15px;">🎯</div>
            <h3 style="margin-bottom: 15px;">Recognize Face</h3>
            <p style="margin-bottom: 20px; opacity: 0.9;">Real-time face recognition using your camera feed</p>
            <a href="/recognize" class="btn" style="background: white; color: #10B981;">Start Recognition</a>
