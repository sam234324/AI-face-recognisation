<div class="card">
    <h2 style="text-align: center; margin-bottom: 30px; color: #1F2937;">Register New User</h2>
    
    <div style="display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: start;">
        <div>
            <div class="form-group">
                <label for="userName">Full Name:</label>
                <input type="text" id="userName" placeholder="Enter your full name" required>
            </div>
            
            <div style="text-align: center; margin-bottom: 20px;">
                <button id="startRegistration" class="btn">Start Camera & Registration</button>
                <button id="stopRegistration" class="btn btn-danger" style="display: none;">Stop Registration</button>
            </div>
            
            <div id="registrationStatus" class="status info" style="display: none;">
                Initializing camera...
            </div>
            
            <div id="captureProgress" style="display: none; margin-top: 20px;">
                <div style="background: #E5E7EB; border-radius: 10px; overflow: hidden;">
                    <div id="progressBar" style="height: 20px; background: #3B82F6; width: 0%; transition: width 0.1s ease;"></div>
                </div>
                <p style="text-align: center; margin-top: 10px; color: #6B7280;">
                    Capturing facial data... <span id="timeRemaining">5</span> seconds remaining
                </p>
            </div>
        </div>
        
        <div style="text-align: center;">
            <div class="video-container">
                <video id="video" width="400" height="300" style="display: none;"></video>
                <canvas id="overlay" width="400" height="300" style="display: none;"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
let video, canvas, ctx;
let isRegistering = false;
let faceDescriptors = [];
let captureInterval;
let progressInterval;
let modelsLoaded = false;

async function loadModels() {
    const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@latest/model';
    
    try {
        await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
        await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
        await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);
        modelsLoaded = true;
        console.log('Face recognition models loaded successfully');
    } catch (error) {
        console.error('Error loading models:', error);
        updateStatus('Error loading AI models. Please refresh the page.', 'error');
    }
}

function updateStatus(message, type = 'info') {
    const status = document.getElementById('registrationStatus');
    status.textContent = message;
    status.className = `status ${type}`;
    status.style.display = 'block';
}

async function startCamera() {
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ 
            video: { width: 400, height: 300 }
        });
        
        video = document.getElementById('video');
        canvas = document.getElementById('overlay');
        ctx = canvas.getContext('2d');
        
        video.srcObject = stream;
        video.style.display = 'block';
        canvas.style.display = 'block';
        
        return new Promise(resolve => {
            video.onloadedmetadata = () => {
                video.play();
                resolve();
            };
        });
    } catch (error) {
        console.error('Error accessing camera:', error);
        updateStatus('Error accessing camera. Please allow camera permissions.', 'error');
        throw error;
    }
}

async function detectFaces() {
    if (!video || video.paused || video.ended) return;
    
    const detections = await faceapi
        .detectAllFaces(video, new faceapi.TinyFaceDetectorOptions())
        .withFaceLandmarks()
        .withFaceDescriptors();
    
    // Clear canvas
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    if (detections.length > 0) {
        // Draw face detection boxes
        const resizedDetections = faceapi.resizeResults(detections, {
            width: video.videoWidth,
            height: video.videoHeight
        });
        
        faceapi.draw.drawDetections(canvas, resizedDetections);
        faceapi.draw.drawFaceLandmarks(canvas, resizedDetections);
        
        // Store face descriptors during registration
        if (isRegistering) {
            detections.forEach(detection => {
                if (detection.descriptor) {
                    faceDescriptors.push(Array.from(detection.descriptor));
                }
            });
        }
    }
    
    requestAnimationFrame(detectFaces);
}

async function startRegistration() {
    const userName = document.getElementById('userName').value.trim();
    
    if (!userName) {
        updateStatus('Please enter your name first.', 'error');
        return;
    }
    
    if (!modelsLoaded) {
        updateStatus('AI models are still loading. Please wait...', 'error');
        return;
    }
    
    try {
        updateStatus('Starting camera...', 'info');
        await startCamera();
        
        updateStatus('Camera started. Position your face in the frame.', 'success');
        
        // Start face detection
        detectFaces();
        
        // Wait 2 seconds before starting capture
        setTimeout(() => {
            startCapture();
        }, 2000);
        
    } catch (error) {
        updateStatus('Failed to start registration.', 'error');
    }
}

function startCapture() {
    isRegistering = true;
    faceDescriptors = [];
    
    updateStatus('Capturing facial data... Keep looking at the camera!', 'info');
    
    document.getElementById('startRegistration').style.display = 'none';
    document.getElementById('stopRegistration').style.display = 'inline-block';
    document.getElementById('captureProgress').style.display = 'block';
    
    let timeLeft = 5;
    let progress = 0;
    
    progressInterval = setInterval(() => {
        progress += 2; // 100% / 50 intervals (5 seconds * 10 intervals per second)
        timeLeft -= 0.1;
        
        document.getElementById('progressBar').style.width = progress + '%';
        document.getElementById('timeRemaining').textContent = Math.ceil(timeLeft);
        
        if (timeLeft <= 0) {
            completeRegistration();
        }
    }, 100);
}

async function completeRegistration() {
    clearInterval(progressInterval);
    isRegistering = false;
    
    document.getElementById('captureProgress').style.display = 'none';
    document.getElementById('stopRegistration').style.display = 'none';
    document.getElementById('startRegistration').style.display = 'inline-block';
    
    if (faceDescriptors.length === 0) {
        updateStatus('No face detected during capture. Please try again.', 'error');
        return;
    }
    
    updateStatus(`Processing ${faceDescriptors.length} facial samples...`, 'info');
    
    try {
        const userName = document.getElementById('userName').value.trim();
        
        const response = await fetch('/api/register', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                name: userName,
                descriptors: faceDescriptors
            })
        });
        
        const result = await response.json();
        
        if (response.ok) {
            updateStatus(`Registration successful! ${userName} has been registered with ${faceDescriptors.length} facial samples.`, 'success');
            document.getElementById('userName').value = '';
            
            // Stop camera
            if (video && video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
                video.style.display = 'none';
                canvas.style.display = 'none';
            }
        } else {
            updateStatus(result.error || 'Registration failed.', 'error');
        }
    } catch (error) {
        console.error('Registration error:', error);
        updateStatus('Registration failed. Please try again.', 'error');
    }
}

function stopRegistration() {
    clearInterval(progressInterval);
    isRegistering = false;
    
    document.getElementById('captureProgress').style.display = 'none';
    document.getElementById('stopRegistration').style.display = 'none';
    document.getElementById('startRegistration').style.display = 'inline-block';
    
    updateStatus('Registration stopped.', 'info');
    
    // Stop camera
    if (video && video.srcObject) {
        video.srcObject.getTracks().forEach(track => track.stop());
        video.style.display = 'none';
        canvas.style.display = 'none';
    }
}

// Event listeners
document.getElementById('startRegistration').addEventListener('click', startRegistration);
document.getElementById('stopRegistration').addEventListener('click', stopRegistration);

// Load models on page load
loadModels();
</script>