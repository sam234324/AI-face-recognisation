<div class="card">
    <h2 style="text-align: center; margin-bottom: 30px; color: #1F2937;">Face Recognition</h2>
    
    <div style="display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: start;">
        <div>
            <div style="text-align: center; margin-bottom: 20px;">
                <button id="startRecognition" class="btn">Start Camera & Recognition</button>
                <button id="stopRecognition" class="btn btn-danger" style="display: none;">Stop Recognition</button>
            </div>
            
            <div id="recognitionStatus" class="status info" style="display: none;">
                Initializing camera...
            </div>
            
            <div id="recognitionResult" class="recognition-result" style="display: none;">
                <h3>Recognition Result:</h3>
                <div id="resultContent"></div>
            </div>
            
            <div id="registeredUsers" style="margin-top: 30px;">
                <h3 style="color: #1F2937; margin-bottom: 15px;">Registered Users:</h3>
                <div id="usersList" style="background: #F9FAFB; padding: 20px; border-radius: 10px;">
                    Loading users...
                </div>
            </div>
        </div>
        
        <div style="text-align: center;">
            <div class="video-container">
                <video id="video" width="400" height="300" style="display: none;"></video>
                <canvas id="overlay" width="400" height="300" style="display: none;"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
let video, canvas, ctx;
let isRecognizing = false;
let labeledDescriptors = [];
let faceMatcher;
let modelsLoaded = false;
let recognitionInterval;
let detectionHistory = new Map(); // For temporal consistency
let qualityThreshold = 0.7; // Minimum quality score for face samples

// Enhanced model loading with better models
async function loadModels() {
    const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@latest/model';
    
    try {
        // Load higher accuracy models instead of tiny detector
        await faceapi.nets.ssdMobilenetv1.loadFromUri(MODEL_URL); // Better than tinyFaceDetector
        await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
        await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);
        await faceapi.nets.ageGenderNet.loadFromUri(MODEL_URL); // Additional verification
        
        modelsLoaded = true;
        console.log('Enhanced face recognition models loaded successfully');
        
        // Load registered users
        await loadRegisteredUsers();
    } catch (error) {
        console.error('Error loading models:', error);
        updateStatus('Error loading AI models. Please refresh the page.', 'error');
    }
}

// Enhanced face quality assessment
function assessFaceQuality(detection, landmarks) {
    let qualityScore = 1.0;
    
    // Check face size (larger faces are generally better)
    const faceSize = detection.box.width * detection.box.height;
    const minSize = 50 * 50; // Minimum face size
    if (faceSize < minSize) {
        qualityScore *= 0.3;
    } else if (faceSize < 100 * 100) {
        qualityScore *= 0.7;
    }
    
    // Check face angle using landmarks
    if (landmarks) {
        const leftEye = landmarks.getLeftEye();
        const rightEye = landmarks.getRightEye();
        const nose = landmarks.getNose();
        
        // Calculate face rotation
        const eyeCenter1 = leftEye.reduce((sum, point) => ({ x: sum.x + point.x, y: sum.y + point.y }), { x: 0, y: 0 });
        const eyeCenter2 = rightEye.reduce((sum, point) => ({ x: sum.x + point.x, y: sum.y + point.y }), { x: 0, y: 0 });
        eyeCenter1.x /= leftEye.length;
        eyeCenter1.y /= leftEye.length;
        eyeCenter2.x /= rightEye.length;
        eyeCenter2.y /= rightEye.length;
        
        const eyeAngle = Math.abs(Math.atan2(eyeCenter2.y - eyeCenter1.y, eyeCenter2.x - eyeCenter1.x));
        
        // Penalize tilted faces
        if (eyeAngle > 0.2) qualityScore *= 0.6;
        if (eyeAngle > 0.4) qualityScore *= 0.3;
    }
    
    // Check detection confidence
    if (detection.score < 0.8) qualityScore *= 0.5;
    if (detection.score < 0.6) qualityScore *= 0.2;
    
    return Math.max(0, Math.min(1, qualityScore));
}

async function loadRegisteredUsers() {
    try {
        const response = await fetch('/api/users');
        const users = await response.json();
        
        if (users.length === 0) {
            document.getElementById('usersList').innerHTML = 
                '<p style="color: #6B7280; text-align: center;">No users registered yet. <a href="/register">Register a user</a> to start recognition.</p>';
            return;
        }
        
        // Convert user descriptors to LabeledFaceDescriptors with quality filtering
        labeledDescriptors = users.map(user => {
            let descriptors = user.descriptors.map(desc => new Float32Array(desc));
            
            // If we have quality scores, filter out low-quality samples
            if (user.qualityScores) {
                descriptors = descriptors.filter((desc, index) => 
                    user.qualityScores[index] >= qualityThreshold
                );
            }
            
            return new faceapi.LabeledFaceDescriptors(user.name, descriptors);
        }).filter(descriptor => descriptor.descriptors.length > 0);
        
        // Create face matcher with stricter threshold for better accuracy
        faceMatcher = new faceapi.FaceMatcher(labeledDescriptors, 0.45); // Reduced from 0.6
        
        // Display registered users with quality info
        const usersList = users.map(user => {
            const highQualitySamples = user.qualityScores ? 
                user.qualityScores.filter(score => score >= qualityThreshold).length : 
                user.descriptors.length;
            
            return `<div style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background: white; border-radius: 5px; margin-bottom: 10px;">
                <div>
                    <strong>${user.name}</strong>
                    <br><small style="color: #6B7280;">${highQualitySamples}/${user.descriptors.length} high-quality samples</small>
                </div>
                <button onclick="deleteUser('${user.id}')" class="btn btn-danger" style="padding: 5px 10px; font-size: 0.8rem;">Delete</button>
            </div>`;
        }).join('');
        
        document.getElementById('usersList').innerHTML = usersList;
        
    } catch (error) {
        console.error('Error loading users:', error);
        document.getElementById('usersList').innerHTML = 
            '<p style="color: #EF4444; text-align: center;">Error loading users. Please refresh the page.</p>';
    }
}

async function deleteUser(userId) {
    if (!confirm('Are you sure you want to delete this user?')) return;
    
    try {
        const response = await fetch(`/api/users/${userId}`, {
            method: 'DELETE'
        });
        
        if (response.ok) {
            await loadRegisteredUsers();
            updateStatus('User deleted successfully.', 'success');
        } else {
            updateStatus('Failed to delete user.', 'error');
        }
    } catch (error) {
        console.error('Delete error:', error);
        updateStatus('Failed to delete user.', 'error');
    }
}

function updateStatus(message, type = 'info') {
    const status = document.getElementById('recognitionStatus');
    status.textContent = message;
    status.className = `status ${type}`;
    status.style.display = 'block';
}

async function startCamera() {
    try {
        // Request higher resolution for better accuracy
        const stream = await navigator.mediaDevices.getUserMedia({ 
            video: { 
                width: { ideal: 640, min: 480 }, 
                height: { ideal: 480, min: 360 },
                frameRate: { ideal: 30 }
            }
        });
        
        video = document.getElementById('video');
        canvas = document.getElementById('overlay');
        ctx = canvas.getContext('2d');
        
        video.srcObject = stream;
        video.style.display = 'block';
        canvas.style.display = 'block';
        
        return new Promise(resolve => {
            video.onloadedmetadata = () => {
                // Set canvas dimensions to match video
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                video.play();
                resolve();
            };
        });
    } catch (error) {
        console.error('Error accessing camera:', error);
        updateStatus('Error accessing camera. Please allow camera permissions.', 'error');
        throw error;
    }
}

// Enhanced recognition with temporal consistency
async function recognizeFaces() {
    if (!video || video.paused || video.ended || !isRecognizing) return;
    
    // Use better detector with optimized settings
    const detections = await faceapi
        .detectAllFaces(video, new faceapi.SsdMobilenetv1Options({ 
            minConfidence: 0.5,
            maxResults: 10
        }))
        .withFaceLandmarks()
        .withFaceDescriptors();
    
    // Clear canvas
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    if (detections.length > 0) {
        const resizedDetections = faceapi.resizeResults(detections, {
            width: video.videoWidth,
            height: video.videoHeight
        });
        
        // Filter detections by quality
        const qualityDetections = resizedDetections.filter(detection => {
            const quality = assessFaceQuality(detection.detection, detection.landmarks);
            return quality >= 0.3; // Minimum quality threshold
        });
        
        if (qualityDetections.length > 0) {
            // Draw detection boxes
            faceapi.draw.drawDetections(canvas, qualityDetections);
            
            if (faceMatcher && labeledDescriptors.length > 0) {
                // Perform enhanced face recognition
                const results = await performEnhancedRecognition(qualityDetections);
                
                // Draw labels with quality indicators
                results.forEach((result, i) => {
                    const box = qualityDetections[i].detection.box;
                    const quality = assessFaceQuality(qualityDetections[i].detection, qualityDetections[i].landmarks);
                    const confidence = Math.round((1 - result.distance) * 100);
                    
                    const label = result.label !== 'unknown' ? 
                        `${result.label} (${confidence}% | Q:${Math.round(quality * 100)}%)` :
                        `Unknown (Q:${Math.round(quality * 100)}%)`;
                    
                    const drawBox = new faceapi.draw.DrawBox(box, { 
                        label: label,
                        boxColor: result.label !== 'unknown' ? 'green' : 'red'
                    });
                    drawBox.draw(canvas);
                });
                
                // Display recognition results
                displayEnhancedResults(results, qualityDetections);
            }
        }
    } else {
        // No faces detected
        document.getElementById('recognitionResult').style.display = 'none';
        detectionHistory.clear();
    }
    
    setTimeout(recognizeFaces, 100); // Run every 100ms
}

// Enhanced recognition with multiple verification methods
async function performEnhancedRecognition(detections) {
    const results = [];
    
    for (let i = 0; i < detections.length; i++) {
        const detection = detections[i];
        const descriptor = detection.descriptor;
        
        // Primary face matching
        const primaryMatch = faceMatcher.findBestMatch(descriptor);
        
        // Temporal consistency check
        const faceId = `face_${i}`;
        if (!detectionHistory.has(faceId)) {
            detectionHistory.set(faceId, []);
        }
        
        const history = detectionHistory.get(faceId);
        history.push(primaryMatch);
        
        // Keep only last 10 detections for consistency check
        if (history.length > 10) {
            history.shift();
        }
        
        // Majority voting for stable results
        let finalMatch = primaryMatch;
        if (history.length >= 3) {
            const labelCounts = {};
            history.forEach(match => {
                labelCounts[match.label] = (labelCounts[match.label] || 0) + 1;
            });
            
            const mostCommonLabel = Object.keys(labelCounts).reduce((a, b) => 
                labelCounts[a] > labelCounts[b] ? a : b
            );
            
            // If majority agrees and it's not unknown, use majority result
            if (labelCounts[mostCommonLabel] >= Math.ceil(history.length / 2) && mostCommonLabel !== 'unknown') {
                const matchesForLabel = history.filter(match => match.label === mostCommonLabel);
                const avgDistance = matchesForLabel.reduce((sum, match) => sum + match.distance, 0) / matchesForLabel.length;
                finalMatch = { label: mostCommonLabel, distance: avgDistance };
            }
        }
        
        results.push(finalMatch);
    }
    
    return results;
}

function displayEnhancedResults(results, detections) {
    const resultDiv = document.getElementById('recognitionResult');
    const contentDiv = document.getElementById('resultContent');
    
    if (results.length === 0) {
        resultDiv.style.display = 'none';
        return;
    }
    
    // Find best quality match
    let bestMatch = null;
    let bestQuality = 0;
    
    results.forEach((result, index) => {
        if (result.label !== 'unknown') {
            const quality = assessFaceQuality(detections[index].detection, detections[index].landmarks);
            if (quality > bestQuality) {
                bestQuality = quality;
                bestMatch = { ...result, quality };
            }
        }
    });
    
    if (bestMatch && bestMatch.quality >= 0.5) {
        const confidence = Math.round((1 - bestMatch.distance) * 100);
        const qualityPercent = Math.round(bestMatch.quality * 100);
        
        contentDiv.innerHTML = `
            <div style="display: flex; align-items: center; gap: 15px;">
                <div style="font-size: 2rem;">✅</div>
                <div>
                    <div style="font-size: 1.3rem; font-weight: bold; color: #059669;">
                        ${bestMatch.label}
                    </div>
                    <div class="confidence">
                        Confidence: ${confidence}% | Quality: ${qualityPercent}%
                    </div>
                    <div style="font-size: 0.8rem; color: #6B7280;">
                        Enhanced matching with temporal consistency
                    </div>
                </div>
            </div>
        `;
    } else {
        const unknownCount = results.filter(r => r.label === 'unknown').length;
        contentDiv.innerHTML = `
            <div style="display: flex; align-items: center; gap: 15px;">
                <div style="font-size: 2rem;">❓</div>
                <div>
                    <div style="font-size: 1.3rem; font-weight: bold; color: #DC2626;">
                        Unknown Person${unknownCount > 1 ? 's' : ''}
                    </div>
                    <div class="confidence">
                        ${unknownCount} face${unknownCount > 1 ? 's' : ''} detected - No matching user found
                    </div>
                    <div style="font-size: 0.8rem; color: #6B7280;">
                        Improve lighting and face position for better recognition
                    </div>
                </div>
            </div>
        `;
    }
    
    resultDiv.style.display = 'block';
}

async function startRecognition() {
    if (!modelsLoaded) {
        updateStatus('AI models are still loading. Please wait...', 'error');
        return;
    }
    
    if (labeledDescriptors.length === 0) {
        updateStatus('No users registered. Please register users first.', 'error');
        return;
    }
    
    try {
        updateStatus('Starting enhanced recognition...', 'info');
        await startCamera();
        
        isRecognizing = true;
        detectionHistory.clear(); // Clear history for new session
        updateStatus('Enhanced recognition active. Position face clearly in good lighting.', 'success');
        
        document.getElementById('startRecognition').style.display = 'none';
        document.getElementById('stopRecognition').style.display = 'inline-block';
        
        // Start recognition
        recognizeFaces();
        
    } catch (error) {
        updateStatus('Failed to start recognition.', 'error');
    }
}

function stopRecognition() {
    isRecognizing = false;
    detectionHistory.clear();
    
    document.getElementById('startRecognition').style.display = 'inline-block';
    document.getElementById('stopRecognition').style.display = 'none';
    document.getElementById('recognitionResult').style.display = 'none';
    
    updateStatus('Recognition stopped.', 'info');
    
    // Stop camera
    if (video && video.srcObject) {
        video.srcObject.getTracks().forEach(track => track.stop());
        video.style.display = 'none';
        canvas.style.display = 'none';
    }
}

// Utility function to help users improve registration quality
function getRegistrationTips() {
    return `
    <div style="background: #F3F4F6; padding: 15px; border-radius: 8px; margin: 10px 0;">
        <h4 style="margin-top: 0; color: #374151;">Tips for Better Recognition Accuracy:</h4>
        <ul style="margin: 10px 0; padding-left: 20px; color: #6B7280;">
            <li>Ensure good, even lighting on the face</li>
            <li>Look directly at the camera (avoid tilted faces)</li>
            <li>Keep face at least 100x100 pixels in size</li>
            <li>Register multiple photos from different angles</li>
            <li>Avoid shadows, reflections, or obstructions</li>
            <li>Register 5-10 high-quality samples per person</li>
        </ul>
    </div>
    `;
}

// Event listeners
document.getElementById('startRecognition').addEventListener('click', startRecognition);
document.getElementById('stopRecognition').addEventListener('click', stopRecognition);

// Add tips to the page if there's a tips container
document.addEventListener('DOMContentLoaded', () => {
    const tipsContainer = document.getElementById('accuracyTips');
    if (tipsContainer) {
        tipsContainer.innerHTML = getRegistrationTips();
    }
});

// Load models and users on page load
loadModels();
</script>